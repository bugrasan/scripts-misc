#!/usr/bin/env bash
# fake podman for the pm stub tests: appends each call to $PODMAN_LOG, one
# line per call with every argument in printf %q form, and answers the
# subcommands pm uses; it never runs a container
#
# state below $STUB_STATE, per fake container <name> (names double as IDs):
#   containers/<name>  its network (one line, empty for podman's default)
#   status/<name>      its state (default: $STUB_STATUS, else running)
#   mounts/<name>      one mount per line, as <source>:<target>[:<type>];
#                      the type defaults to bind
#   ids/<id>           the name of the container with this extra ID; pm
#                      may name a container by either
#   home/<name>        $HOME of its user (default /home/vscode)
#   labels/<name>      a pm-hc label of an earlier v9 build; pm must never
#                      read one (V9-49), so a format that asks for it fails
#   pmscript/<name>    the value of its pm-script label
#   create/<name>      its podman run arguments, each ended by a NUL
#   secrets/<name>     its mount secrets, one name per line
#   cores/<name>       present while a core runs in it: run and start make
#                      it when the main command is hc serve (pm run --hc),
#                      tests make it for others; podman stop ends it
#   nohc/<name>        present when it has no hc
#   nosha/<name>       present when it has no sha256sum
#   fs/<name>/...      its files, from podman cp
#   cbin/<name>        the PATH of its sha256 script
# and networks/<name> per fake network
# settings, all optional:
#   STUB_PODMAN_VERSION version that --version reports (default 6.2.0)
#   STUB_SECRETS        names of the podman secrets that exist
#   STUB_RUN_RC         exit status of `run`; a failed run leaves the
#                       container created, as podman does (default 0)
#   STUB_RUN_EXIT       when set, `run` succeeds, but the main command ends
#                       at once, as hc serve where the image lacks hc: the
#                       container is exited, with no core
#   STUB_START_RC       exit status of `start` (default 0)
#   STUB_STOP_RC        exit status of `stop` (default 0)
#   STUB_HCCONF_RC      exit status of the herdr-core config.toml write of
#                       pm run --hc, which then writes nothing
#   STUB_CP_RC          exit status of `cp` (default 0)
#   STUB_NET_CREATE_RC  exit status of `network create` (default 0)
#   STUB_STATUS         state of containers without a status file
#   STUB_EXEC_DELAY     seconds each exec of pm ps takes (default 0); the
#                       peak of those running at once lands in execs.max
#   STUB_IMAGES, STUB_NETWORKS, STUB_PS
#                       lines `image list`, `network ls`, and `ps` (without
#                       -q) print; unset STUB_PS lists the fake containers

# one write per call, as pm runs some podman calls at the same time
line=$(printf '%q ' "$@")
printf '%s\n' "$line" >>"${PODMAN_LOG:?}"

s=${STUB_STATE:?}
c=$s/containers n=$s/networks
last=${!#}   # pm passes the container or network last, after --
us=$'\x1f' rs=$'\x1e'
# a container named by an extra ID stands for its name from here on
[[ -e $c/$last || ! -e $s/ids/$last ]] || last=$(<"$s/ids/$last")
# pm no longer reads the pm-hc label (V9-49): fail loudly if it does
if [[ $* == *'"pm-hc"'* || $* == *label=pm-hc* ]]; then
  echo 'stub: pm asked podman for the pm-hc label' >&2
  exit 99
fi

# status <name>: the state of a fake container
status() { if [[ -e $s/status/$1 ]]; then cat -- "$s/status/$1"; else printf '%s\n' "${STUB_STATUS:-running}"; fi; }
# val <dir> <name>: the content of a state file, or nothing
val() { [[ ! -e $s/$1/$2 ]] || cat -- "$s/$1/$2"; }
# track <1|-1>: count the execs of pm ps that run at once, under a lock
# made by mkdir (portable, unlike flock), and keep the peak in execs.max;
# a lock that stays taken for about 10 seconds fails the call, not the run
track() {
  local n m t=0
  until mkdir -- "$s/execs.lock" 2>/dev/null; do
    (( ++t <= 1000 )) || { echo 'stub: execs.lock stays taken' >&2; exit 97; }
    sleep 0.01
  done
  n=$(( $(cat -- "$s/execs.run" 2>/dev/null || echo 0) + $1 ))
  m=$(cat -- "$s/execs.max" 2>/dev/null || echo 0)
  printf '%s\n' "$n" >"$s/execs.run"
  (( n <= m )) || printf '%s\n' "$n" >"$s/execs.max"
  rmdir -- "$s/execs.lock"
}
# hcmain <name>: true when its main command, the last create argument,
# runs hc serve, as with pm run --hc
hcmain() {
  local -a a=()
  [[ ! -e $s/create/$1 ]] || mapfile -t -d '' a <"$s/create/$1"
  (( ${#a[@]} )) && [[ ${a[${#a[@]}-1]} == *'hc serve'* ]]
}
# mounts <name>: its mounts, one per line, as <type><RS><source><RS><target>
mounts() {
  local m src rest
  [[ -e $s/mounts/$1 ]] || return 0
  while IFS= read -r m; do
    src=${m%%:*} rest=${m#*:}
    if [[ $rest == *:* ]]; then printf '%s%s%s%s%s\n' "${rest#*:}" "$rs" "$src" "$rs" "${rest%%:*}"
    else printf 'bind%s%s%s%s\n' "$rs" "$src" "$rs" "$rest"; fi
  done <"$s/mounts/$1"
}
# jcreate <name>: its create command as podman's json prints it
jcreate() {
  local -a a=()
  [[ ! -e $s/create/$1 ]] || mapfile -t -d '' a <"$s/create/$1"
  if (( ${#a[@]} == 0 )); then echo null; return; fi
  "${STUB_PYTHON:?}" -I -c 'import json, sys
print(json.dumps(sys.argv[1:], separators=(",", ":"), ensure_ascii=False))' "${a[@]}"
}

case ${1-} in
  --version) printf 'podman version %s\n' "${STUB_PODMAN_VERSION:-6.2.0}"; exit 0 ;;
  secret)
    if [[ ${2-} == exists ]]; then
      [[ " ${STUB_SECRETS-} " == *" $last "* ]]
      exit
    fi ;;
  container)
    case ${2-} in
      exists) [[ -e $c/$last ]]; exit ;;
      inspect)
        fmt=$4
        # the formats of pm ps and the mount scan of pm run inspect all
        # given containers at once; fields as pm asks
        if [[ $fmt == *NetworkMode* || $fmt == *'{{.Source}}'* ]]; then
          for id in "${@:5}"; do
            [[ -e $c/$id ]] || continue
            net=$(val containers "$id") ms='' secs=''
            if [[ $fmt == *NetworkMode* ]]; then
              # pm ps: id, name, status, pm-script, devcontainer folder,
              # target=source mounts, networks, network mode, create
              # command as json, mount secrets
              while IFS=$rs read -r _ src dst; do ms+="$dst=$src;"; done < <(mounts "$id")
              if [[ -e $s/secrets/$id ]]; then
                while IFS= read -r m; do secs+=$m$rs; done <"$s/secrets/$id"
              fi
              printf '%s\n' "$id$us$id$us$(status "$id")$us$(val pmscript "$id")$us$us$ms$us${net:+$net,}$us${net:+bridge}${net:-pasta}$us$(jcreate "$id")$us$secs"
            else
              # pm run: names and mount sources
              while IFS=$rs read -r _ src _; do ms+=$src$rs; done < <(mounts "$id")
              printf '%s\n' "$id$us$ms"
            fi
          done
          exit 0
        fi
        if [[ ! -e $c/$last ]]; then
          printf 'Error: no such container %s\n' "$last" >&2
          exit 125
        fi
        case $fmt in
          # pm rm: the name and the state, then one network per line
          '{{.Name}}'*NetworkSettings*)
            printf '%s\n' "$last"
            status "$last"
            printf '%s\n' "$(val containers "$last")" ;;
          # pm hc-add, pm hc-rm: the name and the state, then each mount as
          # <type><RS><target>, all after unit separators
          '{{.Name}}'*.Mounts*)
            ms=''
            while IFS=$rs read -r t _ dst; do ms+=$us$t$rs$dst; done < <(mounts "$last")
            printf '%s\n' "$last$us$(status "$last")$ms" ;;
          # pm run, when a container already mounts the folder
          '{{.State.Status}}') status "$last" ;;
          *State.Running*)
            if [[ $(status "$last") == running ]]; then echo true; else echo false; fi ;;
          *) printf '[{"Name":"%s"}]\n' "$last" ;;
        esac
        exit 0 ;;
    esac ;;
  network)
    case ${2-} in
      inspect)
        if [[ ! -e $n/$last ]]; then
          printf 'Error: unable to find network with name or ID %s\n' "$last" >&2
          exit 125
        fi
        # pm run asks for name, label, driver, and isolate; pm rm for the label
        case $* in
          *'{{.Name}}'*) printf '%s\x1f%s\x1f%s\x1f%s\n' "$last" 8 bridge strict ;;
          *) echo 8 ;;
        esac
        exit 0 ;;
      create)
        [[ ${STUB_NET_CREATE_RC:-0} == 0 ]] || exit "$STUB_NET_CREATE_RC"
        : >"$n/$last"
        printf '%s\n' "$last"
        exit 0 ;;
      rm) rm -f -- "$n/$last"; printf '%s\n' "$last"; exit 0 ;;
      ls) [[ -z ${STUB_NETWORKS-} ]] || printf '%s\n' "$STUB_NETWORKS"; exit 0 ;;
    esac ;;
  run)
    # remember the container, its network, mounts, pm-script label, and
    # arguments
    args=("$@") name='' net='' script='' vols=()
    for (( i = 1; i < ${#args[@]} - 1; i++ )); do
      case ${args[i]} in
        --name)    name=${args[i+1]} ;;
        --network) net=${args[i+1]} ;;
        -v)        vols+=("${args[i+1]%:ro}") ;;
        --label)
          [[ ${args[i+1]} != pm-script=* ]] || script=${args[i+1]#pm-script=} ;;
      esac
    done
    if [[ -n $name ]]; then
      printf '%s\n' "$net" >"$c/$name"
      printf '%s\0' podman "${args[@]}" >"$s/create/$name"
      (( ${#vols[@]} == 0 )) || printf '%s\n' "${vols[@]}" >"$s/mounts/$name"
      [[ -z $script ]] || printf '%s\n' "$script" >"$s/pmscript/$name"
    fi
    if [[ ${STUB_RUN_RC:-0} != 0 ]]; then
      [[ -z $name ]] || printf 'created\n' >"$s/status/$name"
      echo 'Error: stub: podman run failed' >&2
      exit "$STUB_RUN_RC"
    fi
    # hc serve as the main command: the core runs with the container;
    # with STUB_RUN_EXIT, the main command and the container end at once
    if [[ -n ${STUB_RUN_EXIT-} ]]; then
      [[ -z $name ]] || printf 'exited\n' >"$s/status/$name"
    else
      [[ -z $name ]] || ! hcmain "$name" || : >"$s/cores/$name"
    fi
    echo 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
    exit 0 ;;
  start)
    if [[ ! -e $c/$last ]]; then
      printf 'Error: no container with name or ID "%s" found\n' "$last" >&2
      exit 125
    fi
    [[ ${STUB_START_RC:-0} == 0 ]] || { echo 'Error: stub: podman start failed' >&2; exit "$STUB_START_RC"; }
    printf 'running\n' >"$s/status/$last"
    ! hcmain "$last" || : >"$s/cores/$last"
    printf '%s\n' "$last"
    exit 0 ;;
  stop)
    # the container ends, and with it its core
    if [[ ! -e $c/$last ]]; then
      printf 'Error: no container with name or ID "%s" found: no such container\n' "$last" >&2
      exit 125
    fi
    [[ ${STUB_STOP_RC:-0} == 0 ]] || { echo 'Error: stub: podman stop failed' >&2; exit "$STUB_STOP_RC"; }
    printf 'exited\n' >"$s/status/$last"
    rm -f -- "$s/cores/$last"
    printf '%s\n' "$last"
    exit 0 ;;
  top)
    # args of the container's processes: the init, sleep, and the core
    printf 'COMMAND\n/run/podman-init -- sleep infinity \nsleep infinity \n'
    [[ ! -e $s/cores/$2 ]] || printf 'hc serve \n'
    exit 0 ;;
  exec)
    args=("$@") ctr=$2 script='' j=0
    # the container: the word after --, else the one after exec
    for (( i = 1; i < ${#args[@]}; i++ )); do
      if [[ ${args[i]} == -- ]]; then ctr=${args[i+1]}; break; fi
    done
    [[ -e $c/$ctr || ! -e $s/ids/$ctr ]] || ctr=$(<"$s/ids/$ctr")
    # as podman 6.2: no exec into a container that does not run
    if [[ $(status "$ctr") != running ]]; then
      echo 'Error: can only create exec sessions on running containers: container state improper' >&2
      exit 255
    fi
    # shellcheck disable=SC2016  # pm's literal script, matched as text
    case $* in
      *'printf %s "$HOME"'*)
        # pm hc-add: $HOME of the container user; STUB_HOME_WARN adds a
        # podman warning on stderr, STUB_HOME_RC makes the exec fail
        [[ -z ${STUB_HOME_WARN-} ]] || printf '%s\n' "$STUB_HOME_WARN" >&2
        if [[ -n ${STUB_HOME_RC-} ]]; then
          echo 'Error: stub: exec failed' >&2
          exit "$STUB_HOME_RC"
        fi
        if [[ -e $s/home/$ctr ]]; then printf '%s' "$(<"$s/home/$ctr")"; else printf '/home/vscode'; fi
        exit 0 ;;
      *'/.config/herdr-core/config.toml')
        # pm run --hc, pm hc-add: pm's own script writes the config into
        # the fake files of the container, from stdin
        if [[ -n ${STUB_HCCONF_RC-} ]]; then
          echo 'Error: stub: write failed' >&2
          exit "$STUB_HCCONF_RC"
        fi
        for (( i = 0; i < ${#args[@]}; i++ )); do
          [[ ${args[i]} != -c ]] || script=${args[i+1]}
        done
        "${STUB_SH:?}" -c "$script" sh "$s/fs/$ctr$last"
        exit ;;
      *'/proc/[0-9]*'*)
        # pm ps: the herdr state in the container
        track 1
        sleep "${STUB_EXEC_DELAY:-0}"
        if [[ -e $s/cores/$ctr ]]; then echo running
        elif [[ -e $s/nohc/$ctr ]]; then echo unavailable
        else echo stopped; fi
        track -1
        exit 0 ;;
      *sha256sum*)
        # pm ps --agents: pm's own script on the fake files, with nothing on
        # PATH but a sha256sum from stub/hash-tool, unless the container has
        # none; portable where the host lacks sha256sum
        for (( i = 0; i < ${#args[@]}; i++ )); do
          [[ ${args[i]} != -c ]] || script=${args[i+1]}
          [[ ${args[i]} != sh ]] || j=$i
        done
        cbin=$s/cbin/$ctr
        mkdir -p -- "$cbin"
        rm -f -- "$cbin/sha256sum"
        if [[ ! -e $s/nosha/$ctr ]]; then
          printf '#!%s\nexec %q %q "$@"\n' "${STUB_BASH:?}" "$STUB_BASH" "${STUB_HASH_TOOL:?}" >"$cbin/sha256sum"
          chmod 755 "$cbin/sha256sum"
        fi
        files=()
        for f in "${args[@]:j+1}"; do files+=("$s/fs/$ctr$f"); done
        track 1
        sleep "${STUB_EXEC_DELAY:-0}"
        env -u STUB_HASH_LOG PATH="$cbin" "${STUB_SH:?}" -c "$script" sh "${files[@]}"
        rc=$?
        track -1
        exit "$rc" ;;
      *' mkdir -p '*) mkdir -p -- "$s/fs/$ctr$last"; exit 0 ;;
    esac
    exit 0 ;;
  cp)
    # podman cp -- <source> <container>:<path>, into the fake file system
    [[ ${STUB_CP_RC:-0} == 0 ]] || { echo 'Error: stub: podman cp failed' >&2; exit "$STUB_CP_RC"; }
    src=${*: -2:1} ctr=${last%%:*} path=${last#*:}
    mkdir -p -- "$s/fs/$ctr${path%/*}"
    cp -- "$src" "$s/fs/$ctr$path"
    exit 0 ;;
  rm)
    for d in containers status mounts labels home pmscript create cores nohc nosha; do rm -f -- "$s/$d/$last"; done
    # its files go with it
    rm -rf -- "${s:?}/fs/$last" "${s:?}/cbin/$last"
    printf '%s\n' "$last"
    exit 0 ;;
  ps)
    if [[ " $* " == *' -q '* ]]; then
      # IDs: all with -a, else the running ones
      for f in "$c"/*; do
        [[ -e $f ]] || continue
        [[ " $* " == *' -a '* || $(status "${f##*/}") == running ]] && printf '%s\n' "${f##*/}"
      done
    elif [[ -n ${STUB_PS+set} || " $* " != *' {{.Names}} '* ]]; then
      [[ -z ${STUB_PS-} ]] || printf '%s\n' "$STUB_PS"
    else
      # completion without STUB_PS: the names of the fake containers,
      # running ones unless --all or -a, then those in any of the states
      # that --filter status=<state> names; any other filter (network=,
      # volume=) lists nothing, as before
      want=() args=("$@")
      for (( i = 1; i < ${#args[@]} - 1; i++ )); do
        [[ ${args[i]} == --filter ]] || continue
        [[ ${args[i+1]} == status=* ]] || exit 0
        want+=("${args[i+1]#status=}")
      done
      for f in "$c"/*; do
        [[ -e $f ]] || continue
        st=$(status "${f##*/}")
        [[ " $* " == *' --all '* || " $* " == *' -a '* || $st == running ]] || continue
        (( ${#want[@]} == 0 )) || [[ " ${want[*]} " == *" $st "* ]] || continue
        printf '%s\n' "${f##*/}"
      done
    fi
    exit 0 ;;
  image) [[ -z ${STUB_IMAGES-} ]] || printf '%s\n' "$STUB_IMAGES"; exit 0 ;;
esac
exit 0
